msgstr ""
"Öffne Deine Authenticator-App und gib den aktuellen Code für diese Website "
"ein."

#: app/Services/TwoFa/TotpTwoFaMethod.php:307
msgid "Authentication Code"
msgstr "Bestätigungscode"

#: app/Services/TwoFa/TotpTwoFaMethod.php:318
